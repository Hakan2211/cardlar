# ─── Convex (database, file storage, realtime) ───────────────────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# ─── App ─────────────────────────────────────────────────────────────────
# Public base URL. In dev this can be your LAN IP (e.g. http://192.168.1.20:3000)
# so you can open dev cards on your phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI providers ────────────────────────────────────────────────────────
# Which backend generates images/music.
#   fal   — fal.ai (production quality; requires FAL_KEY)
#   local — local ComfyUI: Krea 2 Turbo (image), Qwen-Image-Edit (edit),
#           ACE-Step 1.5 (music). Dev only, refused in production.
#   mock  — placeholder images, no music (fully offline)
# Unset defaults to `fal` when FAL_KEY is present, otherwise `mock`.
AI_PROVIDER=

# fal.ai credentials (needed when AI_PROVIDER=fal)
FAL_KEY=

# ─── Local ComfyUI (needed when AI_PROVIDER=local) ───────────────────────
# Leave COMFY_URL unset to auto-detect ComfyUI on 127.0.0.1:8188/8000/8080/8001.
# Set it only if ComfyUI listens somewhere else.
# Requires ComfyUI >= 0.26 — the `krea2` CLIP type (Qwen3-VL encoder) does not
# exist before that, and Krea 2 cannot run without it.
COMFY_URL=

# Model filenames as they appear in ComfyUI. Override only if yours differ.
COMFY_KREA2_UNET=krea2_turbo-Q8_0.gguf
COMFY_KREA2_CLIP=qwen3vl_4b_bf16.safetensors
COMFY_QWEN_VAE=qwen_image_vae.safetensors
COMFY_EDIT_UNET=Qwen-Image-Edit-2509-Q5_K_M.gguf
COMFY_EDIT_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
COMFY_ACE_CHECKPOINT=ace_step_1.5_turbo_aio.safetensors

# Length of generated music, in seconds.
LOCAL_MUSIC_SECONDS=60

# ─── Owner Mode (free card creation) ─────────────────────────────────────
# Dev-only: when true (and NODE_ENV !== production), skip payment everywhere.
OWNER_MODE=
# Works in production too: present this secret to /admin (or POST to
# /api/admin/create-card) to mint a real, shareable card for free. Use a long
# random string and keep it private.
ADMIN_SECRET=

# ─── Stripe (payments) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
