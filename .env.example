# ─── Convex (database, file storage, realtime) ───────────────────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# ─── App ─────────────────────────────────────────────────────────────────
# Public base URL. In dev this can be your LAN IP (e.g. http://192.168.1.20:3000)
# so you can open dev cards on your phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI providers ────────────────────────────────────────────────────────
# Which backend generates images/music.
#   fal   — fal.ai (production quality; requires FAL_KEY)
#   local — local Stable Diffusion WebUI + /public/dev-tracks (dev only,
#           refused in production)
#   mock  — placeholder images, no music (fully offline)
# Unset defaults to `fal` when FAL_KEY is present, otherwise `mock`.
AI_PROVIDER=

# fal.ai credentials (needed when AI_PROVIDER=fal)
FAL_KEY=

# Local model endpoints (needed when AI_PROVIDER=local)
# Automatic1111 / Forge-compatible Stable Diffusion API:
LOCAL_IMAGE_URL=http://127.0.0.1:7860
# Reserved for a future local music backend (MusicGen/ACE-Step). Until then,
# local music picks royalty-free files from /public/dev-tracks.
LOCAL_MUSIC_URL=

# ─── Owner Mode (free card creation) ─────────────────────────────────────
# Dev-only: when true (and NODE_ENV !== production), skip payment everywhere.
OWNER_MODE=
# Works in production too: present this secret to /admin (or POST to
# /api/admin/create-card) to mint a real, shareable card for free. Use a long
# random string and keep it private.
ADMIN_SECRET=

# ─── Stripe (payments) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
